				    #"Coluna Condicional Adicionada1" = Table.AddColumn(#"Coluna Condicional Adicionada", "tipo_venda", each if [COD_LOJA] = 800001 then "Digital" else "Lojistas"),
				    #"Coluna Condicional Adicionada2" = Table.AddColumn(#"Coluna Condicional Adicionada1", "ds_faixa_idade", each if [ds_idade] <= 30 then "1. Até 30" else if [ds_idade] <= 40 then "2. 31 a 40" else if [ds_idade] <= 50 then "3. 41 a 50" else if [ds_idade] <= 60 then "4. 51 a 60" else "5. Acima de 60"),

table REL_Veiculo_Producao
	lineageTag: da1a4012-2f12-413d-9515-76c40c4c386f

	measure 'qtd contrato' =
			
			CALCULATE(
			    DISTINCTCOUNT(REL_Veiculo_Producao[COD_CONTRATO])
			)
		formatString: #,0
		lineageTag: a56d6c10-5ef3-4b4b-a3ae-daff541251bb

		changedProperty = FormatString

	measure '% Aproveitamento' =
			
			DIVIDE(
			    sum(REL_Veiculo_Producao[QTDE_AUTO_PAN])
			    , [qtd contrato]
			    , BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 22a0c1d2-038f-44b6-884b-9db75f3bf6dd

		changedProperty = FormatString

	measure 'TM Seguro' =
			
			DIVIDE(
			    sum(REL_Veiculo_Producao[SEGURO_AUTO_PAN])
			    , sum(REL_Veiculo_Producao[QTDE_AUTO_PAN])
			    , BLANK()
			)
		formatString: #,0.0
		lineageTag: 632f89e9-5d97-444d-9510-986a14f612f1

		changedProperty = FormatString

	measure 'TM Emprestimo' =
			
			DIVIDE(
			    CALCULATE(
			        sum(REL_Veiculo_Producao[VAL_PRINCIPAL])
			    )
			    , [qtd contrato]
			    , BLANK()
			)
		formatString: #,0.0
		lineageTag: b628cfa6-1176-4789-9ef3-025355798ab9

		changedProperty = FormatString

	measure 'Qtd. Emitidos' =
			
			CALCULATE(
			    COUNT(REL_Veiculo_Producao[DATA_EMISSAO_AUTO_PAN])
			)
		formatString: #,0
		lineageTag: 761891e1-c2f4-4a88-8d42-5627f7336034

		changedProperty = FormatString

	measure 'qtd seguros' = Sum(REL_Veiculo_Producao[QTDE_AUTO_PAN])
		formatString: #,0
		lineageTag: ef86e3b9-6f57-47b5-a4f1-5c87b19e774c

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}


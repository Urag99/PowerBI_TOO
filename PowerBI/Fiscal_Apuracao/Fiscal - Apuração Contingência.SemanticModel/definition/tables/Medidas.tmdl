			    , REL_APURACAO_FISCAL_CONTINGENCIA[ds_Base_Calculo] = "Base de cálculo"
			    , REMOVEFILTERS(
			            REL_APURACAO_FISCAL_CONTINGENCIA[ds_Tipo]
			            , REL_APURACAO_FISCAL_CONTINGENCIA[ds_Base_Calculo]

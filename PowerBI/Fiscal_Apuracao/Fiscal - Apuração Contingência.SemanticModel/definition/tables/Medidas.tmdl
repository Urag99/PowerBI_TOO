	measure 'vl total manipulado' =
			
			VAR _total = [vl_total_receitas] + [vl_total_exclusoes]
			
			var _realizado = suM(REL_APURACAO_FISCAL_CONTINGENCIA[vl_Realizado])
			
			RETURN
			// ISINSCOPE(REL_APURACAO_FISCAL_CONTINGENCIA[ds_Tipo])
			IF(
			    ISINSCOPE(REL_APURACAO_FISCAL_CONTINGENCIA[ds_Tipo])
			    , _realizado, // Value for individual rows
			    _total          // Specific calculation for Total Row
			)
		formatString: #,0
		lineageTag: a2b1f704-a271-4ce5-95ab-4b0aa3f90a45

		annotation PBI_FormatHint = {"isDecimal":true}

	measure totalizador =
			
			[vl_total_receitas] + [vl_total_exclusoes]
		formatString: #,0
		lineageTag: fc271317-2e4b-4f09-b05b-acfd6b30eb79

		annotation PBI_FormatHint = {"isDecimal":true}


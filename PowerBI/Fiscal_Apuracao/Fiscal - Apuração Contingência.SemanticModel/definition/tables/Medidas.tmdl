	measure vl_cofins_devido =
			
			CALCULATE(
			    sum(REL_APURACAO_FISCAL_CONTINGENCIA[vl_Realizado])
			    , REL_APURACAO_FISCAL_CONTINGENCIA[ds_Grupo] = "A Recolher"
			    , REL_APURACAO_FISCAL_CONTINGENCIA[ds_Tipo] = "COFINS"
			)
		formatString: #,0
		lineageTag: 942e5468-d300-4477-bf4a-22120a15ccc5

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'vl_pis_devido M-1' = ```
			
			
			VAR _ant = 
			CALCULATE(
			    [vl_pis_devido]
			    , PREVIOUSMONTH(REL_APURACAO_FISCAL_CONTINGENCIA[dt_Competencia].[Date])
			    , ALL(REL_APURACAO_FISCAL_CONTINGENCIA[dt_Competencia])
			)
			
			var _atu = [vl_pis_devido]
			
			RETURN
			IF(ISBLANK(_ant) || _ant = 0
			    , 0
			    ,DIVIDE(
			        _atu
			        , _ant
			        ,0
			    ) - 1
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bde6092c-b80e-4f1e-8ec7-032fe0e46a77


			    sum(REL_APURACAO_FISCAL_CONTINGENCIA[vl_Realizado])
			    , REL_APURACAO_FISCAL_CONTINGENCIA[ds_Grupo] = "A Recolher"
			    , REL_APURACAO_FISCAL_CONTINGENCIA[ds_Tipo] = "PIS"
			)
		formatString: #,0

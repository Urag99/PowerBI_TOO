	partition CON_DA_Corretora_V2 = m
		mode: import
		source = ```
				let
				    Fonte = Sql.Database("SQL-SANDBOX", "CONTROLADORIA", [Query="select #(lf)#(tab)tpLancamento#(lf)#(tab), isnull(cdContaContabil, '')#(tab)as cdContaContabil#(lf)#(tab), periodo#(lf)#(tab), dsPacote#(lf)#(tab), dsSubPacote#(lf)#(tab), isnull(cdFornecedor,'')#(tab)#(tab)as cdFornecedor#(lf)#(tab), isnull(dsFornecedor,'')#(tab)#(tab)as dsFornecedor#(lf)#(tab), isnull(vlRealizado ,0)#(tab)#(tab)as vlRealizado #(lf)#(tab), isnull(vlOrcado#(tab) ,0)#(tab)#(tab)as vlOrcado#(lf)from CON_DA_Corretora_V2"]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"periodo", type date}}),
				    #"Personalização Adicionada" = Table.AddColumn(#"Tipo Alterado", "tp_periodo", each if [periodo] < Date.StartOfMonth(DateTime.Date(DateTime.LocalNow())) 
				then "Fechado"
				else "Aberto"),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Personalização Adicionada", "periodo", "periodo - Copiar"),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Coluna Duplicada",{{"periodo - Copiar", "dt_competencia"}})
				in
				    #"Colunas Renomeadas"
				```


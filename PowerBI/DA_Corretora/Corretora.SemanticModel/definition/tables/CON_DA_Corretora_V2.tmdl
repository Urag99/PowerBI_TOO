table CON_DA_Corretora_V2
	lineageTag: ef6bef74-cefb-4f8a-b80b-c0cec963b3e1

	measure 'VL_Realizado Y-1' =
			
			CALCULATE(
			    SUM(CON_DA_Corretora_V2[vlRealizado])
			    , DATEADD(Calendario[Date], -1, YEAR)
			)

table REL_Fianca_Producao
	lineageTag: 124a920d-3964-4921-9342-e67c087be80d

	measure '% Renovação' = ```
			
			IFERROR( 
			    DIVIDE(
			        CALCULATE(
			            DISTINCTCOUNT(
			                REL_Fianca_Producao[cd_Apolice]
			            ), 
			            REL_Fianca_Producao[fl_Renovadas] = "Renovação",
			            REL_Fianca_Producao[fl_Apolice] = "sim"
			        ),
			        CALCULATE(
			            DISTINCTCOUNT(
			                REL_Fianca_Producao[cd_Apolice]
			            ), 
			--            REL_Fianca_Producao[fl_Renovadas] = "sim";
			            REL_Fianca_Producao[fl_Apolice] = "sim"
			        )
			    ),""
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 976c9827-04fc-4be1-810d-ec90c81062b7

	measure 'Qtde Apolice' =
			
			IFERROR(
			    CALCULATE(
			        DISTINCTCOUNT(
			            REL_Fianca_Producao[cd_Apolice]
			        ),
			        REL_Fianca_Producao[fl_Apolice] = "sim"
			    ),""
			)
		formatString: #,0
		lineageTag: c191184e-1382-4d3e-838c-603e0eda323e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Correlação Qtde Apolice e % Renovação para nm_Corretor' =
			
			VAR __CORRELATION_TABLE = VALUES('REL_Fianca_Producao'[nm_Corretor])
			VAR __COUNT =
				COUNTX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([Qtde Apolice] * [% Renovação])
				)
			VAR __SUM_X = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([Qtde Apolice]))
			VAR __SUM_Y = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([% Renovação]))
			VAR __SUM_XY =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([Qtde Apolice] * [% Renovação] * 1.)
				)
			VAR __SUM_X2 = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([Qtde Apolice] ^ 2))
			VAR __SUM_Y2 = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([% Renovação] ^ 2))
			RETURN
				DIVIDE(
					__COUNT * __SUM_XY - __SUM_X * __SUM_Y * 1.,
					SQRT(
						(__COUNT * __SUM_X2 - __SUM_X ^ 2)
							* (__COUNT * __SUM_Y2 - __SUM_Y ^ 2)
					)
				)
		lineageTag: 26082c27-f6f6-4ef4-8bdd-0dfe78d9647e

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "CorrelationCoefficient"
				}

	measure 'Qtde Apolice Renovadas' =
			
			IFERROR(
			    CALCULATE(
			        DISTINCTCOUNT(
			            REL_Fianca_Producao[cd_Apolice]
			        ),
			        REL_Fianca_Producao[fl_Apolice] = "sim",
			        REL_Fianca_Producao[fl_Renovadas] = "Renovação"
			    ),""
			)
		formatString: #,0
		lineageTag: 97ec1c71-046e-4d09-928d-ff87ac5d217d

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Qtde Apolices Novas' = ```

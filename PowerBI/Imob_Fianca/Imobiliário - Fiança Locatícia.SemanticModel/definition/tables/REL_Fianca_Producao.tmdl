	measure '% Ating Meta' = (sum(REL_Fianca_Producao_Agrupado[vl_Vendas]) - sum(REL_Fianca_Producao_Agrupado[vl_Cancelamento]) - sum(REL_Fianca_Producao_Agrupado[vl_Restituicao])) / sum (REL_Fianca_Meta[vl_Orcado])

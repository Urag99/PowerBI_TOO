	measure 'Last Date Qt Contratos Zoho' = ```
			
			// IFERROR(
			//     CALCULATE(
			//         SUM(REL_Habitacional_Base_Vendas[qtContratos]);
			//         FILTER( REL_Habitacional_Base_Vendas;
			//                REL_Habitacional_Base_Vendas[Chave de Data] = max(REL_Habitacional_Base_Vendas[Chave de Data]))

			IFERROR(
			    CALCULATE(
			        SUM(REL_Habitacional_Base_Vendas[qtContratos]),
			               REL_Habitacional_Base_Vendas[dtMesFaturado] = ult_dt
			               ,all(REL_Habitacional_Zoho_Visitas[dtVisita])
			            --LASTDATE(
			          --REL_Habitacional_Base_Vendas[dtMesFaturado]
			        --)
			    ),BLANK()

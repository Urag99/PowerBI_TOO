	measure 'Mes Anterior Qt Contratos' = ```
			
			
			
			var ult_dt = CALCULATE(
			            DATEADD(LASTDATE(REL_Habitacional_Base_Vendas[dtMesFaturado]), -1, MONTH)
			             , all(REL_Habitacional_Zoho_CCA)
			            )
			
			
			return
			IFERROR(
			    CALCULATE(
			        SUM(REL_Habitacional_Base_Vendas[qtContratos]),
			        --DATEADD(LASTDATE(REL_Habitacional_Base_Vendas[dtMesFaturado]);-1;MONTH)
			        REL_Habitacional_Base_Vendas[dtMesFaturado] = ult_dt,
			        all(REL_Habitacional_Zoho_Visitas[dtVisita])
			        ),BLANK()
			    )
			
			```
		formatString: #,0
		lineageTag: e8a95424-b2ed-4f5c-9b05-c304b4536cab

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Crecimento Mês Atual x Anterior' =
			
			iferror(
			    divide(
			         [Last Year Qtd Contratos]
			        ,[Mes Anterior Qt Contratos]
			    )-1
			    ,BLANK()
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 16d737d5-db50-40c6-b643-13896f88c8bd


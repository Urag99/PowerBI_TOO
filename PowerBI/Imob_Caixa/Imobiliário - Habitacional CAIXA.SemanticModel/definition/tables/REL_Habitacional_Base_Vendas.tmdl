table REL_Habitacional_Base_Vendas
	lineageTag: 7dd64d4e-2e2b-490f-97a3-535ed5102b4a

	measure '% Repres Construtora' = ```
			
			IFERROR(
			    DIVIDE(
			        SUM(
			            REL_Habitacional_Base_Vendas[qtContratos]
			        ),
			        CALCULATE(
			            SUM(
			                REL_Habitacional_Base_Vendas[qtContratos]
			            ),
			            ALL(
			                REL_Habitacional_Base_Vendas[nmConstrutora]
			            )
			        )
			    ),""
			)
			
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: cc30eb71-3b42-4cf9-97fa-ce85691fd1c2

	measure '% Crecimento MoM' = ```
			
				VAR __PREV_MONTH =
					CALCULATE(
						sum([qtContratos]),
						DATEADD('REL_Habitacional_Base_Vendas'[dtMesFaturado].[Date], -1, MONTH)
					)
				RETURN
					DIVIDE(sum(REL_Habitacional_Base_Vendas[qtContratos]) - __PREV_MONTH, __PREV_MONTH)
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 49d7c395-9f5d-47d7-813c-9d173cb50f7b

	measure 'R$ Crecimento MoM' = ```
			
				VAR __PREV_MONTH =
					CALCULATE(
						sum([qtContratos]),
						DATEADD('REL_Habitacional_Base_Vendas'[dtMesFaturado].[Date], -1, MONTH)
					)
				RETURN
					sum(REL_Habitacional_Base_Vendas[qtContratos]) - __PREV_MONTH
			```
		formatString: #,0
		lineageTag: 22d5d577-a4cf-4286-9b9c-25a0aca7a1d3


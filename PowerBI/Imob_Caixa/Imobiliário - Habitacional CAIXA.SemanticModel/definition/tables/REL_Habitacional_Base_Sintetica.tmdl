	measure '% Expectativa x Arquivo CEF' = (sum (REL_Habitacional_Base_Sintetica[qtContratosCarteira]) - sum (REL_Habitacional_Base_Sintetica[qtContratosExpectativa])) / sum (REL_Habitacional_Base_Sintetica[qtContratosCarteira])

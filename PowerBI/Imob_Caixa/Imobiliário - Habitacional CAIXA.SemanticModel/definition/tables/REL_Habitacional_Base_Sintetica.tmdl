	measure 'vl Crecimento MoM Carteira' = ```
			
				VAR __PREV_MONTH =
					CALCULATE(
						sum([vlPremio]),
						DATEADD('REL_Habitacional_Base_Sintetica'[dtCompetencia].[Date], -1, MONTH)
					)
				RETURN
					DIVIDE(sum(REL_Habitacional_Base_Sintetica[vlPremio]) - __PREV_MONTH, __PREV_MONTH)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4a37f398-d5c0-45a8-8bcf-c568a00b2f88

	measure 'qt Crecimento MoM Carteira' = ```
			

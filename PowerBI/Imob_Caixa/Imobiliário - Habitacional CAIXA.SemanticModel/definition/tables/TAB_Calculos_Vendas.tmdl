table TAB_Calculos_Vendas
	lineageTag: a8890975-54b8-4956-aeab-66a19c7e8281

	measure diferenca_m-1_m-2_% = ```
			
			SWITCH(
			     TRUE()
			    ,sum(TAB_Calculos_Vendas[M-1])+sum(TAB_Calculos_Vendas[M-2]) = 0
			    ,BLANK()
			    ,and(
			         sum(TAB_Calculos_Vendas[M-2]) = 0
			        ,sum(TAB_Calculos_Vendas[M-1]) > 0 
			    )
			    ,1
			    ,DIVIDE(
			         sum(TAB_Calculos_Vendas[M-1])
			        ,sum(TAB_Calculos_Vendas[M-2])
			        ,BLANK()
			    )-1
			)
			    
			```
		formatString: #,0%;-#,0%;#,0%
		lineageTag: a404d1d1-877a-41c5-aa27-d17b9717535c


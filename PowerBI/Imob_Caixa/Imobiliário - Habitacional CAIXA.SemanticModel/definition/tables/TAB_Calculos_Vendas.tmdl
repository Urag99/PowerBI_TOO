				    #"Personalização Adicionada2" = Table.AddColumn(#"Personalização Adicionada1", "M-1", each if [data_agrupada] = "3. M-1" then [qtContratos] else  0),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Personalização Adicionada2",{{"Período Anterior", type number}, {"M-2", type number}, {"M-1", type number}}),
				    #"Linhas Agrupadas" = Table.Group(#"Tipo Alterado", {"Grupo_CCA"}, {{"M-2", each List.Sum([#"M-2"]), type nullable number}, {"M-1", each List.Sum([#"M-1"]), type nullable number}}),

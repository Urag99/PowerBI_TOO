				if [Grupo_CCA] = "FALTA INFORMAÇÃO|SEM EXECUTIVO" then "4. Sem Executivo" else 
				if [Grupo_CCA] = "AGENCIA|SEM EXECUTIVO" then "4. Sem Executivo" else 
				if [#"M-1"] > 0  and [#"M-2"] = 0 then "3. Novos" else
				if [#"M-1"] = 0  and [#"M-2"] > 0 then "5. Pararam de Produzir" else
				if [#"diferenca_m-1_m02"] > 0  then "1. Cresceram" else 
				if [#"diferenca_m-1_m02"] < 0 then "2. Caíram" else 
				if [#"diferenca_m-1_m02"] = 0 then "4. Flat" else 

table vw_habitacional_share_fgts
	lineageTag: 012c6e01-3fc9-4087-b454-4bf0178f596a

	measure '% Share TOO FGTS' =
			
			DIVIDE(
			    sum(vw_habitacional_share_fgts[qtd_too])
			    , sum(vw_habitacional_share_fgts[qtd_caixa])
			    , BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 167ce5f1-af45-4b9e-aeb0-f1f3446a7af7

	measure 'Ticket Médio CAIXA FGTS' =
			
			DIVIDE(
			    sum(vw_habitacional_share_fgts[vl_emprestimo])
			    , sum(vw_habitacional_share_fgts[qtd_caixa])
			    , BLANK()
			)
		formatString: #,0
		lineageTag: 41b2d513-13d2-4d30-a7b7-7949559f840d

		annotation PBI_FormatHint = {"isDecimal":true}


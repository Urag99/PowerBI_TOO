table vw_habitacional_share_fgts_deslocada
	lineageTag: a52faaac-706a-4ef0-aca5-44d10748f772

	measure '% Share TOO FGTS Desl' =
			
			DIVIDE(
			    sum(vw_habitacional_share_fgts_deslocada[qtd_too])
			    , sum(vw_habitacional_share_fgts_deslocada[qtd_caixa])
			    , BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8629e5db-0f89-4fc8-9d87-79f24bfa9ee2

	measure 'Ticket Médio CAIXA FGTS desl' =
			
			DIVIDE(
			    sum(vw_habitacional_share_fgts_deslocada[vl_emprestimo])
			    , sum(vw_habitacional_share_fgts_deslocada[qtd_caixa])
			    , BLANK()
			)
		formatString: #,0
		lineageTag: 031d9416-b431-467f-a6ea-73ce4315a36d

		annotation PBI_FormatHint = {"isDecimal":true}


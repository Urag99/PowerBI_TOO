	measure %_Seguro_Financiado =
			
			DIVIDE(
			    SUM(REL_EP_Digital_Banco_Pan_Producao[vl_seguro])
			    ,SUM(REL_EP_Digital_Banco_Pan_Producao[vl_financiado_total])
			    ,BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7bffc7db-1ba5-4623-be1e-553862d2e6bc

		changedProperty = FormatString


	column faixa_cancelado = ```
			
			
			var data = REL_EP_Digital_Banco_Pan_Producao[tempo_cancelamento]
			
			return
			IF(data >= 1 && data <=30, "1) Até 30 dias",
			    IF(data >= 31 && data <=60, "2) 31 - 60 dias",
			        IF(data >= 61 && data <=90, "3) 60 - 90 dias",
			            IF(data >= 91 && data <=120, "4) 90 - 120 dias",
			                IF(data > 120, "5) Acima de 120 dias", "0) Não Cancelado"
			                  )
			            )
			        )
			    ) 
			 )     
			```
		lineageTag: 55d902ad-8ab0-4b17-a2ae-600d506a57f4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


	column 'potencial seguro adicional Motos' = ```
			
			
			var ma_unificado = 
			if('REL_Veiculo_Producao (2)'[FINANC_MOTO] = 0 && 'REL_Veiculo_Producao (2)'[QTDE_MOTO] = 1
			    , 1
			    ,'REL_Veiculo_Producao (2)'[FINANC_MOTO])
			
			return
			If('REL_Veiculo_Producao (2)'[potencialPP_unificado] = 1, 
			        if(ma_unificado= 1 
			            ,1 
			            )
			 ,0
			)
			
			
			```
		formatString: #,0
		lineageTag: 7511e7ef-fa82-42fd-8dca-925db1fd329a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'qtd seguro adicional motos' =
			
			if('REL_Veiculo_Producao (2)'[QTDE_PP] = 1
			    , If('REL_Veiculo_Producao (2)'[QTDE_MOTO] = 1
			        , 1
			   ,0)
			,0
			)
		formatString: #,0
		lineageTag: 86873afd-cfa8-4bbf-8d02-9fc5019b466b
		summarizeBy: sum


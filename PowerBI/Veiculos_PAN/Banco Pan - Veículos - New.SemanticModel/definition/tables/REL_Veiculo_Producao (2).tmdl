	column 'qtd seguro adicional' = ```
			
			if('REL_Veiculo_Producao (2)'[QTDE_PP] = 1
			    ,If('REL_Veiculo_Producao (2)'[QTDE_GM] = 1 
			        || 'REL_Veiculo_Producao (2)'[qtde_auto_assist] = 1 
			        || 'REL_Veiculo_Producao (2)'[qtde_rcf] = 1
			        , 1
			    ,0)
			,0
			)
			```
		formatString: #,0
		lineageTag: fa1c2ea5-f222-44e2-a2bf-030750b19d4e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'potencial seguro adicional' = ```
			
			If('REL_Veiculo_Producao (2)'[potencialPP_unificado] = 1, 
			        if(     'REL_Veiculo_Producao (2)'[potencialGM_unificado] = 1 || 
			                'REL_Veiculo_Producao (2)'[potencialAA_unificado] = 1 ||
			                'REL_Veiculo_Producao (2)'[potencialRCF_unificado] = 1 
			                ,1 )
			 ,0
			)
			
			
			```
		formatString: #,0
		lineageTag: 92caa37a-a417-4267-9d7a-e4a6880ae913
		summarizeBy: sum


	measure '% WO Cliente PP v2' =
			
			
			var wayout = sum(vw_veiculo_wayout[QTD_WAYOUT_CLIENTE_PP])
			
			var denominador = wayout + sum(vw_veiculo_wayout[QTD_PP])
			
			RETURN
			DIVIDE(
			    wayout
			    , denominador
			    , BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 922040bc-feed-41e8-bbe6-3f04a0a1f617


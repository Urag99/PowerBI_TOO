	measure qtd_loja_distinta = DISTINCTCOUNTNOBLANK(vw_veiculo_wayout[COD_LOJA])
		formatString: #,0
		lineageTag: b1d950d3-4476-47a7-b51a-6a1583b07fcd

	measure qtd_loja_distinta_lojista =
			
			CALCULATE(
			    [qtd_loja_distinta]
			    , vw_veiculo_wayout[QTD_WAYOUT_LOJISTA_PP] >= 1
			)
		formatString: #,0
		lineageTag: 22b25c50-789a-42f6-99fa-368aaaeba39a

	measure qtd_loja_distinta_cliente =
			
			CALCULATE(
			    [qtd_loja_distinta]
			    , vw_veiculo_wayout[QTD_WAYOUT_CLIENTE_PP] >= 1
			)
		formatString: #,0
		lineageTag: 3c2ceaab-5690-476a-969b-29e6324108df

	measure '% Reinclusão PP' =
			
			
			var reinclusao = sum(vw_veiculo_wayout[QTD_REINCLUSAO_PP])
			
			var wayout = sum(vw_veiculo_wayout[QTD_WAYOUT_PP])
			
			return
			DIVIDE(
			    reinclusao
			    , wayout
			    , BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8b1ac800-11ae-44d2-a40d-82e7695db44d

	measure 'Qtd Bruta WO Cliente' =
			
			sum(vw_veiculo_wayout[QTD_WAYOUT_CLIENTE_PP])
			+
			sum(vw_veiculo_wayout[QTD_REINCLUSAO_PP])
		formatString: #,0
		lineageTag: 991367e8-5493-4e21-86a3-103b83007b4e

	measure '% WO Cliente Bruto PP v2' =
			
			
			var wayout = sum(vw_veiculo_wayout[QTD_WAYOUT_PP])
			
			var denominador = wayout + sum(vw_veiculo_wayout[QTD_PP])
			
			RETURN
			DIVIDE(
			    wayout
			    , denominador
			    , BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e72f71db-dfa1-4963-8157-e870a9a7939b

	measure 'Qtd WO RCF Motos' =
			
			var x =
			CALCULATE(
			    sum(vw_veiculo_analitico_wayout[QTD_WAYOUT_CLIENTE_RCF])
			    , vw_veiculo_wayout[CONSOLIDADOR] = "MOTOS"
			)
			
			RETURN
			if(x > 0, x , 0 )
		formatString: #,0
		lineageTag: f28a78d2-07aa-4923-9ee5-089b549ca9c3

	measure 'Qtd WO RCF Leves' =
			
			CALCULATE(
			    sum(vw_veiculo_analitico_wayout[QTD_WAYOUT_CLIENTE_RCF])
			    , vw_veiculo_wayout[CONSOLIDADOR] = "LEVES"
			)
		formatString: #,0
		lineageTag: c3ed467c-436c-49d1-9d23-1dcb827e10d1

